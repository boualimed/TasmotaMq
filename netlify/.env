# Generate secrets
node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Create netlify/.env (DO NOT COMMIT)
cat > netlify/.env << 'EOF'
KONNECT_API_KEY=your_sandbox_key
KONNECT_WALLET_ID=your_wallet_id
KONNECT_MODE=sandbox
APP_URL=http://localhost:8888
JWT_SECRET=paste-random-generated-secret
SESSION_SECRET=paste-random-generated-secret
EOF