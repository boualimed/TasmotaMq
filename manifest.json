{
  "name": "Tasmota MQTT Manager",
  "short_name": "Tasmota Hub",
  "description": "Smart home control dashboard for managing Tasmota IoT devices via MQTT with real-time monitoring, automation rules, and AI-powered insights",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "dir": "ltr",
  "lang": "en-US",
  "theme_color": "#1e40af",
  "background_color": "#ffffff",
  "categories": ["productivity", "utilities", "lifestyle"],
  "prefer_related_applications": false,
  
  "icons": [
    {
      "src": "/assets/icons/24x24.png",
      "sizes": "24x24",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/icons/512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  
  "screenshots": [
    {
      "src": "/assets/screenshots/screen.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard view with device controls"
    },
    {
      "src": "/assets/screenshots/widget-screen.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile device management"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Device Dashboard",
      "short_name": "Dashboard",
      "description": "Open main device control dashboard",
      "url": "/",
      "icons": [
        {
          "src": "/assets/icons/48x48.png",
          "sizes": "48x48",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add Device",
      "short_name": "Add Device",
      "description": "Configure new Tasmota device",
      "url": "/?action=add-device",
      "icons": [
        {
          "src": "/assets/icons/48x48.png",
          "sizes": "48x48",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Automation Rules",
      "short_name": "Rules",
      "description": "Manage automation rules",
      "url": "/?view=rules",
      "icons": [
        {
          "src": "/assets/icons/48x48.png",
          "sizes": "48x48",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Analytics",
      "short_name": "Analytics",
      "description": "View device analytics and insights",
      "url": "/?view=analytics",
      "icons": [
        {
          "src": "/assets/icons/48x48.png",
          "sizes": "48x48",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  
  "protocol_handlers": [
    {
      "protocol": "mqtt",
      "url": "/?mqtt=%s"
    }
  ],
  
  "related_applications": [],
  
  "widgets": [
    {
      "name": "Device Status",
      "short_name": "Status",
      "description": "Quick view of device status",
      "tag": "device-status",
      "template": "device-status-template",
      "ms_ac_template": "/widget/ac.json",
      "data": "/widget/data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/assets/screenshots/widget-screen.png",
          "sizes": "750x1334",
          "label": "Device status widget"
        }
      ],
      "icons": [
        {
          "src": "/assets/icons/192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
  
  "iarc_rating_id": "",
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  
  "handle_links": "preferred",
  
  "scope_extensions": [
    {
      "origin": "*.netlify.app"
    }
  ]
}