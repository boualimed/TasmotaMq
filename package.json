{
  "name": "tasmotamqtt",
  "version": "0.0.1",
  "description": "A starter kit for building PWAs!",
  "main": "index.js",
  "scripts": {
    "dev-server": "vite --open",
    "dev": "npm run dev-server",
    "dev-task": "vite",
    "deploy": "npx @azure/static-web-apps-cli login --no-use-keychain && npx @azure/static-web-apps-cli deploy",
    "build": "tsc && vite build",
    "start": "npm run dev",
    "start-remote": "vite --host"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@netlify/functions": "^5.1.0",
    "@shoelace-style/shoelace": "^2.18.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@thepassle/app-tools": "^0.9.12",
    "@types/express": "^5.0.5",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "express": "^5.1.0",
    "firebase": "^12.3.0",
    "lit": "^3.2.1",
    "recharts": "^3.2.1",
    "serverless-http": "^4.0.0",
    "socket.io-client": "^4.8.1",
    "telegram": "^2.26.22",
    "urlpattern-polyfill": "^10.0.0",
    "workbox-build": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "consistent",
    "trailingComma": "es5",
    "endOfLine": "crlf",
    "bracketSpacing": true
  }
}
